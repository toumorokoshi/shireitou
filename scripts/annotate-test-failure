#!/usr/bin/env bash
# annotate-test-failure - turns the failure blocks of a `flutter test` log
# into GitHub Actions error annotations, so they can be read without access
# to the job log.
#
# Usage: scripts/annotate-test-failure <log>
set -euo pipefail

log="${1:?usage: annotate-test-failure <log>}"
[[ -f "$log" ]] || exit 0
# Windows runners (Git Bash) have `python`; `python3` may be a Store stub.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) python=python ;;
  *) python=python3 ;;
esac
"$python" - "$log" <<'PY'
import re
import sys

# Windows consoles default to a legacy code page.
sys.stdout.reconfigure(encoding="utf-8")
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
# Each failure from its heading to the closing rule (at most 3000
# characters): test failures, layout errors and timeouts.
blocks = []
for start in re.finditer(
    r"EXCEPTION CAUGHT BY [A-Z ]+|TimeoutException|Test timed out", text
):
    block = text[start.start() : start.start() + 3000]
    end = re.search(r"\n═{20,}", block[40:])
    blocks.append(block[: end.start() + 40] if end else block)
if not blocks:
    blocks = [text[-3000:]]
# Progress lines the tests print (for example "fake host flows: deny").
progress = re.findall(r"^.*(?:(?:fake|pi) host|mobile) flows: .*$", text, re.M)
if progress:
    blocks.insert(0, "Last progress: " + progress[-1].strip())
for block in blocks[:5]:
    message = block.replace("%", "%25").replace("\r", "").replace("\n", "%0A")
    print(f"::error title=flutter test failure::{message}")
PY
