#!/usr/bin/env bash
# annotate-test-failure - turns the failure blocks of a `flutter test` log
# into GitHub Actions error annotations, so they can be read without access
# to the job log.
#
# Usage: scripts/annotate-test-failure <log>
set -euo pipefail

log="${1:?usage: annotate-test-failure <log>}"
[[ -f "$log" ]] || exit 0
python3 - "$log" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
blocks = re.findall(
    r"(?:EXCEPTION CAUGHT BY FLUTTER TEST FRAMEWORK|TimeoutException|"
    r"Test timed out)[\s\S]{0,3000}?(?:\n═{20,}|\Z)",
    text,
)
if not blocks:
    blocks = [text[-3000:]]
# Progress lines the tests print (for example "fake host flows: deny").
progress = re.findall(r"^.*(?:fake|pi) host flows: .*$", text, re.M)
if progress:
    blocks.insert(0, "Last progress: " + progress[-1].strip())
for block in blocks[:3]:
    message = block.replace("%", "%25").replace("\r", "").replace("\n", "%0A")
    print(f"::error title=flutter test failure::{message}")
PY
