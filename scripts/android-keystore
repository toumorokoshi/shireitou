#!/usr/bin/env bash
# android-keystore - creates the Android release keystore (PKCS12, RSA
# 4096, valid for about 27 years) with a random password and, with
# --upload, stores both in the repository's Actions secrets, so the
# release workflow signs the APK with it (see docs/packaging.md).
#
# Usage: scripts/android-keystore [--upload] <keystore.jks>
#
# Writes <keystore.jks> and <keystore.jks>.password (readable only by
# you) and prints the certificate's SHA-256 fingerprint. They are the
# only copies of the key: back both up (a password manager holds them
# well). Android installs an update only when it is signed with the same
# key, so losing it means users must uninstall to upgrade.
#
# Needs keytool (a JDK 17) and, for --upload, gh signed in with access
# to the repository's secrets.
#
# Optional:
#   ANDROID_KEY_DNAME  the certificate's subject (default: CN=shireitou)
set -euo pipefail

usage="usage: scripts/android-keystore [--upload] <keystore.jks>"
upload=false
if [[ "${1:-}" == --upload ]]; then
  upload=true
  shift
fi
keystore="${1:?$usage}"
alias=shireitou

if [[ -e "$keystore" || -e "$keystore.password" ]]; then
  echo "$keystore (or its .password file) exists; not overwriting it" >&2
  exit 1
fi
if ! command -v keytool >/dev/null || ! keytool -help >/dev/null 2>&1; then
  echo "keytool not found: install a JDK 17 (for example temurin@17)" >&2
  exit 1
fi

umask 077
KEYSTORE_PASSWORD="$(openssl rand -base64 32 | tr -d '/+=\n')"
export KEYSTORE_PASSWORD
printf '%s\n' "$KEYSTORE_PASSWORD" >"$keystore.password"

# PKCS12 keeps one password for the store and the key.
keytool -genkeypair -noprompt \
  -keystore "$keystore" -storetype PKCS12 -storepass:env KEYSTORE_PASSWORD \
  -alias "$alias" -keyalg RSA -keysize 4096 -validity 10000 \
  -dname "${ANDROID_KEY_DNAME:-CN=shireitou}"

fingerprint="$(keytool -list -v -keystore "$keystore" \
  -storepass:env KEYSTORE_PASSWORD -alias "$alias" |
  sed -n 's/^[[:space:]]*SHA256: //p')"
echo "created $keystore (alias $alias), password in $keystore.password"
echo "certificate SHA-256: $fingerprint"

if $upload; then
  # Through stdin, so the values never appear in a process listing.
  base64 <"$keystore" | tr -d '\n' | gh secret set ANDROID_KEYSTORE
  printf '%s' "$KEYSTORE_PASSWORD" | gh secret set ANDROID_KEYSTORE_PASSWORD
  printf '%s' "$alias" | gh secret set ANDROID_KEY_ALIAS
  echo "set ANDROID_KEYSTORE, ANDROID_KEYSTORE_PASSWORD and ANDROID_KEY_ALIAS"
fi
echo "back up $keystore and $keystore.password; they cannot be recovered"
